VITE_APP_NAME="${APP_NAME}"

# The role 1 account created by SuperAdminSeeder. Registration only ever creates
# barangay accounts, so the super admin is provisioned here.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@eblotter.gov.ph
SUPER_ADMIN_PASSWORD=

# AntiqueProvinceSeeder — the pilot's 609 Antique logins (province, 18 municipal
# stations, 590 barangays). All optional; the defaults below are what it uses.
# Credentials it sets are written to storage/app/antique-accounts.csv.
ANTIQUE_SEED_EMAIL_DOMAIN=antique.eblotter.gov.ph
ANTIQUE_SEED_PASSWORD=Antique@2026
# true = a distinct random password per account instead of one shared password
ANTIQUE_SEED_RANDOM_PASSWORDS=false
# true = a re-run also resets the password of accounts that already exist
ANTIQUE_SEED_RESET_PASSWORDS=false
